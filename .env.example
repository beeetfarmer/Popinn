# Single env file shared by dev and prod. Copy to `.env` and fill in secrets.
POPINN_ENV_FILE=.env

# PostgreSQL
POSTGRES_USER=popinn
POSTGRES_PASSWORD=changeme
POSTGRES_DB=popinn

# Backend
DATABASE_URL=postgresql+asyncpg://popinn:changeme@db:5432/popinn
SECRET_KEY=generate-a-strong-secret-key
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_RUNTIME_PATH_CHANGES=false
MEDIA_PATH=/media
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web

LASTFM_CACHE_TTL_HOURS=168
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=true
VIEW_THRESHOLD_RATIO=0.2
# Default minutes between automatic library scans (0 disables it). Also
# settable per-install from Settings, which overrides this default.
LIBRARY_SCAN_INTERVAL_MINUTES=0
# Background job pool size. HLS transcodes can occupy a worker for minutes, so
# with only 2 a batch of them blocks short interactive jobs (metadata refresh).
BACKGROUND_WORKERS=4
STREAM_TOKENIZATION_ENABLED=false
STREAM_TOKEN_REQUIRED=false
STREAM_TOKEN_TTL_SECONDS=21600
RATE_LIMIT_SPOTIFY_SEARCH=45/minute
RATE_LIMIT_LASTFM_SEARCH=45/minute
RATE_LIMIT_ARTIST_METADATA_REFRESH=20/minute
RATE_LIMIT_PLAY_EVENT=240/minute
RATE_LIMIT_SETTINGS_IMPORT=6/minute
SPOTIFY_API_RATE_LIMIT=10/second
LASTFM_API_RATE_LIMIT=5/second
# MusicBrainz throttles to ~1 req/s per IP and often returns transient 503s,
# so it is paced tighter and retried more than the other external APIs.
MUSICBRAINZ_API_RATE_LIMIT=1/second
MUSICBRAINZ_MAX_RETRIES=4
EXTERNAL_API_MAX_RETRIES=2
EXTERNAL_API_RETRY_BACKOFF_SECONDS=0.5
MAX_IMAGE_UPLOAD_BYTES=5242880
MAX_SETTINGS_IMPORT_BYTES=10485760
MAX_SUBTITLE_FILE_BYTES=2097152

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Docker / Compose
# Shared by both dev and prod compose files. Media is mounted read-only
# everywhere; the app only ever writes into APPDATA.
POPINN_MEDIA_PATH=./media
POPINN_APPDATA_PATH=./app-data

# How the backend (image UID 10001) gets write access to APPDATA.
#
#   Rootless podman -> keep-id:uid=10001,gid=10001
#     Remaps UID 10001 to your host user. Without it, podman maps it to an
#     unprivileged subuid and thumbnail/preview writes fail with EACCES.
#
#   Docker -> leave this EMPTY (POPINN_USERNS=)
#     Docker does not understand keep-id and will refuse to start. Instead:
#       mkdir -p ./app-data-dev && sudo chown -R 10001:10001 ./app-data-dev
POPINN_USERNS=keep-id:uid=10001,gid=10001

WEB_PORT=8080
TAG=latest
